# Which environment this process is running in — surfaced in GET /health so
# you can confirm at a glance which environment you're actually hitting.
ENVIRONMENT=development

# Signs every issued JWT (see core/security.py) — the dev default below
# is fine for local work but MUST be overridden with a real, random
# secret anywhere else. Anyone who knows this value can forge a valid
# token for any user.
SECRET_KEY=dev-only-insecure-secret-change-in-production

# Connection string for the primary database. The default below matches
# docker-compose.yml's "db" service — override it if you're running Postgres
# somewhere else. Most managed Postgres providers (RDS, Supabase, Neon,
# etc.) require TLS — append `?ssl=require` to this URL if yours does;
# asyncpg reads it directly from the connection string, no code change
# needed.
DATABASE_URL=postgresql+asyncpg://opsmind:opsmind@localhost:5432/opsmind

# Comma-separated list of origins allowed to make cross-origin requests
# to this API (see main.py's CORSMiddleware). MUST be set to your real
# frontend's origin(s) in any real deployment — the default below only
# works for local development, and there is deliberately no wildcard
# fallback (see core/config.py for why). Must be an EXACT origin, no
# trailing slash (e.g. https://opsmind-ai-pi.vercel.app) — browsers
# reject a wildcard here entirely once allow_credentials=True is set,
# which it is, since the auth cookies require it.
CORS_ALLOWED_ORIGINS_RAW=http://localhost:3000

# How long a refresh token stays valid before it must be replaced by a
# fresh login (see core/security.py / services/auth_service.py).
REFRESH_TOKEN_EXPIRE_DAYS=30

# This backend's OWN public URL — used to build the OAuth redirect_uri
# registered with each provider (e.g. "{BACKEND_BASE_URL}/auth/google/callback").
# MUST exactly match a redirect URI you've registered in that provider's
# console (see docs/oauth-setup.md) or the provider will reject the
# request before it ever reaches this app.
BACKEND_BASE_URL=http://localhost:8000
# Where a completed (or failed) OAuth login sends the user's BROWSER —
# your frontend's origin, not this API's.
FRONTEND_URL=http://localhost:3000

# OAuth providers — all blank by default; every non-OAuth feature (and
# email+password auth) works fine with these unset. See
# docs/oauth-setup.md for how to obtain real values from each provider's
# developer console. Leaving a pair blank makes that provider's
# "Continue with ..." button fail with a clear 503 ("not configured on
# this server") rather than a cryptic error.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" accepts both personal AND work/school Microsoft accounts —
# set to a specific Azure AD tenant ID instead to restrict sign-in to
# one organization.
MICROSOFT_TENANT_ID=common

# Connection pool sizing — see core/database.py. Defaults match
# SQLAlchemy's own built-ins; tune per-environment once real load testing
# gives you a reason to.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Local directory where uploaded document bytes are written (see
# core/storage.py). Override in production to a path on persistent,
# non-ephemeral storage.
STORAGE_DIR=storage/documents

# Where ChromaDB's embedded vector index is written (see
# core/vector_store.py) — same "persistent, non-ephemeral storage in
# production" requirement as STORAGE_DIR above; both are ordinary
# directories a container's own filesystem does not durably keep across
# restarts unless mounted as a real volume (see docker-compose.yml's
# backend_storage/backend_chroma volumes).
CHROMA_PERSIST_DIR=storage/chroma

# Maximum accepted upload size, in bytes. Default: 20 MB.
MAX_UPLOAD_SIZE_BYTES=20971520

# Which LLM backend answers chat questions — see services/llm/factory.py.
# "local" (the default) needs nothing below; it's free, runs in-process,
# no API key. Set to "openai" or "anthropic" (once implemented) only if
# you have a real API key to provide via LLM_API_KEY.
LLM_PROVIDER=local
LLM_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
LLM_API_KEY=
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=256
LLM_REQUEST_TIMEOUT_SECONDS=30.0
