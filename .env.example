# Template for docker-compose.yml — copy to `.env` (gitignored) in this
# same directory before running `docker compose up`. Read by TWO
# different mechanisms, worth telling apart:
#   1. The `docker compose` CLI itself auto-loads a `.env` file here to
#      substitute ${VAR} references inside docker-compose.yml (e.g.
#      ${POSTGRES_USER:-opsmind} below those services).
#   2. The backend service's `env_file: .env` additionally injects every
#      line here as a real environment variable INSIDE that container.
# This is distinct from backend/.env.example, which is for running the
# backend directly on the host (outside Docker) — notably its
# DATABASE_URL uses `localhost`, which would be WRONG inside a
# container; docker-compose.yml deliberately computes DATABASE_URL
# itself from the POSTGRES_* values below rather than trusting a value
# from this file, specifically to prevent that mix-up.

# --- Postgres credentials (used by both the `db` service and to build
# the backend's DATABASE_URL — see docker-compose.yml) ---
POSTGRES_USER=opsmind
POSTGRES_PASSWORD=opsmind
POSTGRES_DB=opsmind

# --- Backend secrets/config not safe to hardcode in docker-compose.yml
# (a version-controlled file) ---

# THE SINGLE MOST IMPORTANT LINE IN THIS FILE FOR A REAL DEPLOYMENT.
# core/config.py defaults this to "development" — and main.py's startup
# check that refuses to boot with the insecure default SECRET_KEY below
# ONLY fires when this is anything other than "development". Forgetting
# to set this variable at all is the one mistake that silently disables
# that safety net, rather than tripping it. Set to "production" (or any
# non-"development" value) for any real deployment.
ENVIRONMENT=production

# MUST be overridden with a real, random secret for any deployment
# other than local development — anyone who knows this value can forge
# a valid auth token for any user (see core/security.py).
SECRET_KEY=dev-only-insecure-secret-change-in-production

# Comma-separated list of origins allowed to call this API from a
# browser (see main.py's CORSMiddleware) — set to your real deployed
# frontend's origin, never a wildcard.
CORS_ALLOWED_ORIGINS_RAW=http://localhost:3000

# "local" (the default) needs nothing below; runs in-process, free, no
# API key. Set to "openai" only if LLM_API_KEY is also set for real.
LLM_PROVIDER=local
LLM_API_KEY=

# --- Auth: refresh tokens + OAuth (see backend/.env.example for the
# full explanation of each) ---
REFRESH_TOKEN_EXPIRE_DAYS=30
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# --- Frontend build-time config ---
# Baked into the CLIENT bundle at image build time (see
# frontend/Dockerfile) — the browser calls this URL directly, so it
# must be reachable from wherever the browser runs, not from inside the
# Docker network. localhost:8000 is correct for local docker-compose use
# (backend's port 8000 is published to the host below); a real
# deployment would set this to that deployment's real public backend URL.
NEXT_PUBLIC_API_URL=http://localhost:8000
